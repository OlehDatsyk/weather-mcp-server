# ==========================================================
# Weather MCP Server - Environment Configuration
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# ==========================================================

# Required: your OpenWeatherMap API key
# Get a free key at: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=a805c3b08b8c6b294e7142e589491ac9

# Base URL for the OpenWeatherMap REST API (rarely needs to change)
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# Default unit system: "metric" (Celsius), "imperial" (Fahrenheit), or "standard" (Kelvin)
DEFAULT_UNITS=metric

# Default language for weather descriptions (ISO 639-1 code)
DEFAULT_LANG=en

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=10

# Number of retries for transient HTTP failures
MAX_RETRIES=3

# Logging level: TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Directory where log files are written
LOG_DIR=logs

# Name of the MCP server (shown to MCP clients)
MCP_SERVER_NAME=weather-mcp-server
